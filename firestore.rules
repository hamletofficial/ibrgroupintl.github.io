    match /hamletDocuments/{documentId} {
      allow read: if request.auth != null && resource.data.uid == request.auth.uid;
      allow create: if request.auth != null
        && request.resource.data.keys().hasAll(['id','uid','dealId','title','category','fileName','storagePath','size','contentType','notes','createdAt'])
        && request.resource.data.keys().hasOnly(['id','uid','dealId','title','category','fileName','storagePath','size','contentType','notes','createdAt'])
        && request.resource.data.id == documentId
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.dealId is string
        && exists(/databases/$(database)/documents/hamletDeals/$(request.resource.data.dealId))
        && get(/databases/$(database)/documents/hamletDeals/$(request.resource.data.dealId)).data.uid == request.auth.uid
        && request.resource.data.title is string
        && request.resource.data.title.size() >= 1
        && request.resource.data.title.size() <= 120
        && request.resource.data.category is string
        && request.resource.data.category.size() <= 50
        && request.resource.data.fileName is string
        && request.resource.data.fileName.size() <= 180
        && request.resource.data.storagePath is string
        && request.resource.data.storagePath.matches('hamletDocuments/' + request.auth.uid + '/.*')
        && request.resource.data.size is int
        && request.resource.data.size > 0
        && request.resource.data.size <= 15 * 1024 * 1024
        && request.resource.data.contentType in ['application/pdf','application/msword','application/vnd.openxmlformats-officedocument.wordprocessingml.document','application/vnd.ms-excel','application/vnd.openxmlformats-officedocument.spreadsheetml.sheet','text/csv','text/plain','image/png','image/jpeg','image/webp']
        && request.resource.data.notes is string
        && request.resource.data.notes.size() <= 300
