        && (!('contactUid' in request.resource.data)
          || (request.resource.data.contactUid is string
            && request.resource.data.contactUid.size() <= 128
            && exists(/databases/$(database)/documents/publicProfiles/$(request.resource.data.contactUid))))
        && request.resource.data.type in ['Acquisition','Disposal','Leasing','Investment','Development']
        && request.resource.data.value is number
        && request.resource.data.value >= 0
        && request.resource.data.stage in [
          'Initial Inspection','LOI Issued','Due Diligence','Under Contract',
          'Lease Execution','Closing','Commission Payout','Closed'
        ]
        && request.resource.data.owner is string
        && request.resource.data.owner.size() <= 80
        && request.resource.data.client is string
        && request.resource.data.client.size() <= 100
        && request.resource.data.notes is string
        && request.resource.data.notes.size() <= 1000
        && (!request.resource.data.keys().hasAny(['sustainability'])
          || (request.resource.data.sustainability is map
            && request.resource.data.sustainability.keys().hasOnly([
              'leedLevel','leedScore','leedReference','leedDate','leedStatus',
              'breeamRating','breeamScore','breeamReference','breeamDate','breeamStatus',
              'epc','energy','carbon','water','notes'
            ])
            && (!('leedLevel' in request.resource.data.sustainability) || request.resource.data.sustainability.leedLevel is string)
            && (!('leedScore' in request.resource.data.sustainability) || request.resource.data.sustainability.leedScore == '' || (request.resource.data.sustainability.leedScore is number && request.resource.data.sustainability.leedScore >= 0 && request.resource.data.sustainability.leedScore <= 110))
            && (!('leedReference' in request.resource.data.sustainability) || (request.resource.data.sustainability.leedReference is string && request.resource.data.sustainability.leedReference.size() <= 120))
            && (!('leedDate' in request.resource.data.sustainability) || request.resource.data.sustainability.leedDate is string)
            && (!('leedStatus' in request.resource.data.sustainability) || request.resource.data.sustainability.leedStatus in ['not-verified','verified-by-member','document-attached','expired','in-progress'])
            && (!('breeamRating' in request.resource.data.sustainability) || request.resource.data.sustainability.breeamRating is string)
            && (!('breeamScore' in request.resource.data.sustainability) || request.resource.data.sustainability.breeamScore == '' || (request.resource.data.sustainability.breeamScore is number && request.resource.data.sustainability.breeamScore >= 0 && request.resource.data.sustainability.breeamScore <= 100))
            && (!('breeamReference' in request.resource.data.sustainability) || (request.resource.data.sustainability.breeamReference is string && request.resource.data.sustainability.breeamReference.size() <= 120))
            && (!('breeamDate' in request.resource.data.sustainability) || request.resource.data.sustainability.breeamDate is string)
            && (!('breeamStatus' in request.resource.data.sustainability) || request.resource.data.sustainability.breeamStatus in ['not-verified','verified-by-member','document-attached','expired','in-progress'])
            && (!('epc' in request.resource.data.sustainability) || request.resource.data.sustainability.epc is string)
            && (!('energy' in request.resource.data.sustainability) || (request.resource.data.sustainability.energy is string && request.resource.data.sustainability.energy.size() <= 100))
            && (!('carbon' in request.resource.data.sustainability) || (request.resource.data.sustainability.carbon is string && request.resource.data.sustainability.carbon.size() <= 100))
            && (!('water' in request.resource.data.sustainability) || (request.resource.data.sustainability.water is string && request.resource.data.sustainability.water.size() <= 100))
            && (!('notes' in request.resource.data.sustainability) || (request.resource.data.sustainability.notes is string && request.resource.data.sustainability.notes.size() <= 600))))
        && request.resource.data.createdAt is string
