  "engines": {
    "node": "24"
  },
  "main": "index.js",
  "dependencies": {
    "express": "^5.2.1",
    "firebase-admin": "^13.6.0",
    "firebase-functions": "^7.0.0",
    "genkit": "^1.42.0",
    "genkit-cli": "^1.43.0"
  },
  "devDependencies": {
    "firebase-functions-test": "^3.4.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "private": true
}
