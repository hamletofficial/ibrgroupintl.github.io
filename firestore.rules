        && (request.auth.token.email == 'uk-hr-enquiries@ibrecruitment.com'
          && request.auth.token.email_verified == true
          || resource.data.uid == request.auth.uid);
      allow create, update, delete: if false;
    }

    // Private transaction document metadata. Binary files live in a matching
