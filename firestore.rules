        && request.resource.data.name.size() <= 80
        && request.resource.data.query is string
        && request.resource.data.query.size() <= 100
        && request.resource.data.stage in ['', 'Initial Inspection','LOI Issued','Due Diligence','Under Contract','Lease Execution','Closing','Commission Payout','Closed']
