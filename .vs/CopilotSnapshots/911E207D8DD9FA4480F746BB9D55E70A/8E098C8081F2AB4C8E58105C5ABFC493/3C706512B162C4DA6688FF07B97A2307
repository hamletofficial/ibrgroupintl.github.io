            </ul>
            <a class="btn btn-ghost" href="/subscribe.html">Get Started</a>
          </div>
          <div class="pricing-card featured">
            <h3>Pro</h3>
            <div class="price">£29.99 <small>/ year</small></div>
            <ul>
              <li>Full executive movement data</li>
              <li>Unlimited member access</li>
              <li>Priority support</li>
            </ul>
            <a class="btn btn-primary" href="/subscribe.html">Subscribe</a>
          </div>
          <div class="pricing-card">
            <h3>Enterprise</h3>
            <div class="price">Contact</div>
            <ul>
              <li>Custom integrations</li>
              <li>Dedicated account manager</li>
              <li>Advanced analytics</li>
            </ul>
            <a class="btn btn-ghost" href="https://www.ibrecruitment.com/contact/">Contact Us</a>
          </div>
        </div>
      </div>
    </section>

    <!-- Workflow Section -->
    <section class="section">
      <div class="container">
        <div class="lead-borderline">How it Works</div>
        <h2>Our Workflow</h2>
        <p class="lead lead-yellow">A seamless process from sign-up to insight delivery, designed for busy HR professionals.</p>
        <div class="workflow">
          <div class="step">
            <div class="step-number">1</div>
            <h3>Sign Up</h3>
            <p>Create your secure account and join our private member community.</p>
          </div>
          <div class="step">
            <div class="step-number">2</div>
            <h3>Explore Insights</h3>
            <p>Access real-time data, reports, and collaborative tools tailored to your needs.</p>
          </div>
          <div class="step">
            <div class="step-number">3</div>
            <h3>Make Confident Decisions</h3>
            <p>Leverage actionable intelligence to drive your recruitment strategy forward.</p>
          </div>
        </div>
        <div class="final-cta">
          <p>Ready to transform your hiring process?</p>
          <a class="btn btn-primary" href="/members.html">Join Now</a>
        </div>
      </div>
    </section>
  </main>

  <footer class="site-footer" role="contentinfo">
    <div class="container">
      <div id="cookieConsentBar" class="cookie-bar">
        <div>
          This website uses cookies to improve your experience.
          <a href="/cookies.html" style="color:#cde9ff">Cookie Policy</a>
          <span aria-hidden="true">|</span>
          <a href="/privacy.html" style="color:#cde9ff">Privacy Policy</a>
        </div>
        <div class="cookie-actions">
          <button id="cookieDeclineBtn" class="btn-small" type="button">Decline</button>
          <button id="cookieAcceptBtn" class="btn-small accept" type="button">Accept</button>
        </div>
      </div>

      <div class="footer-links footer-social">
        <a href="https://www.linkedin.com/company/ibrgroupintl" target="_blank" rel="noopener noreferrer" aria-label="LinkedIn" title="LinkedIn" style="display:inline-flex;align-items:center;justify-content:center;">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M6.94 8.5H3.56V20h3.38V8.5zM5.25 3C4.14 3 3.25 3.9 3.25 5s.89 2 2 2 2-.9 2-2-.9-2-2-2zM20.75 13.38C20.75 10.2 19.07 8.25 16.28 8.25c-1.5 0-2.18.83-2.55 1.41V8.5h-3.38V20h3.38v-6.37c0-1.68.32-3.31 2.4-3.31 2.06 0 2.09 1.93 2.09 3.42V20h3.38v-6.62z"/>
          </svg>
        </a>
      </div>

      <div class="footer-links">
        <a href="/terms.html">Terms</a>
        <span aria-hidden="true">|</span>
        <a href="/privacy.html">Privacy</a>
        <span aria-hidden="true">|</span>
        <a href="/cookies.html">Cookies</a>
      </div>
      <p style="margin:0; text-align:center; color:#FFF">© 2026 Impact in Business Recruitment. All rights reserved.</p>
    </div>
  </footer>

  <script>
    (function () {
      var cookieName = 'ibr_cookie_consent_v1';
      function setCookie(name, value, days) {
        var d = new Date();
        d.setTime(d.getTime() + (days * 24 * 60 * 60 * 1000));
        document.cookie = name + '=' + encodeURIComponent(value) + ';expires=' + d.toUTCString() + ';path=/;SameSite=Lax';
      }
      function getCookie(name) {
        var v = document.cookie.match('(^|;)\\s*' + name + '\\s*=\\s*([^;]+)');
        return v ? decodeURIComponent(v.pop()) : null;
      }
      var bar = document.getElementById('cookieConsentBar');
      if (!bar) return;
      if (getCookie(cookieName)) {
        bar.style.display = 'none';
        return;
      }
      var accept = document.getElementById('cookieAcceptBtn');
      var decline = document.getElementById('cookieDeclineBtn');
      if (accept) accept.addEventListener('click', function () { setCookie(cookieName, 'accepted', 365); bar.style.display = 'none'; });
      if (decline) decline.addEventListener('click', function () { setCookie(cookieName, 'declined', 365); bar.style.display = 'none'; });
    })();
  </script>
  <script>
    window.addEventListener('DOMContentLoaded', function() {
      if (!window.firebase || !window.firebaseConfig) return;
      try { firebase.initializeApp(window.firebaseConfig); } catch (e) {}
      const auth = firebase.auth();
      const signInOutBtn = document.getElementById('signInOutBtn');
      auth.onAuthStateChanged(function(user) {
        if (user) {
          signInOutBtn.textContent = 'Sign Out';
          signInOutBtn.href = '#';
          signInOutBtn.removeAttribute('target');
          signInOutBtn.addEventListener('click', function(e) {
            e.preventDefault();
            auth.signOut().then(function() {
              window.location.reload();
            });
          }, { once: true });
        } else {
          signInOutBtn.textContent = 'Sign In';
          signInOutBtn.href = '/login.html';
          signInOutBtn.setAttribute('target', '_blank');
        }
      });
    });
  </script>
</body>
</html>
