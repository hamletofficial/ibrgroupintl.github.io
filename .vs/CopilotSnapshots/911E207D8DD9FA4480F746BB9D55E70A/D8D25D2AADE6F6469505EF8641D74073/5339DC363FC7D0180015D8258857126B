<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="theme-color" content="#0284c7" />
  <meta name="apple-mobile-web-app-capable" content="yes" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <meta name="robots" content="noindex, follow" />
  <title>Live Feed — LinkedIn Jobs Board</title>
  <link rel="stylesheet" href="/resource-centre.css" />
  <link rel="stylesheet" href="/index.css" />
  <link rel="stylesheet" href="/mobile-compat.css" />
  <link rel="stylesheet" href="/page-transition.css" />
  <script defer src="https://www.gstatic.com/firebasejs/9.22.2/firebase-app-compat.js"></script>
  <script defer src="https://www.gstatic.com/firebasejs/9.22.2/firebase-auth-compat.js"></script>
  <script defer src="https://www.gstatic.com/firebasejs/9.22.2/firebase-firestore-compat.js"></script>
  <script defer src="/firebase-config.js"></script>
  <style>
	:root {
	  --muted: #5b687a;
	  --panel: #ffffff;
	  --border: #dbe3ee;
	  --shadow: 0 10px 28px rgba(2, 6, 23, 0.08);
	  --ink: #0f172a;
	  --brand: #0284c7;
	  --brand-2: #0b2a6f;
	  --good: #16a34a;
	  --warn: #ca8a04;
	  --error: #dc2626;
	}

	* { box-sizing: border-box; }
	html, body { margin: 0; padding: 0; }
	body {
	  font-family: 'Open Sans', Arial, sans-serif;
	  color: var(--ink);
	  background: linear-gradient(180deg, #f5f9ff 0%, #ffffff 100%);
	}

	.page-wrapper {
	  background: #fff;
	  max-width: 1920px;
	  min-height: 100vh;
	  margin: 0 auto;
	  box-shadow: 0 0 20px rgba(0, 0, 0, 0.1);
	}

	.auth-shell {
	  max-width: 820px;
	  margin: 2rem auto;
	  padding: 2rem;
	  border-radius: 16px;
	  border: 1px solid var(--border);
	  background: linear-gradient(145deg, #fff 0%, #f6fbff 100%);
	  text-align: center;
	  box-shadow: var(--shadow);
	}

	.live-shell {
	  display: none;
	  max-width: 1240px;
	  margin: 0 auto 3rem;
	  padding: 0 1rem;
	}

	.sidebar-menu-shell {
	  display: none;
	  position: fixed;
	  top: 88px;
	  left: 24px;
	  width: 240px;
	  background: #ffffff;
	  border: 1px solid var(--border);
	  border-radius: 12px;
	  box-shadow: 0 10px 24px rgba(2, 6, 23, 0.12);
	  padding: 10px 0;
	  z-index: 950;
	}

	.sidebar-menu-link {
	  display: block;
	  padding: 11px 14px;
	  margin: 2px 8px;
	  border-radius: 8px;
	  color: #092a4b;
	  text-decoration: none;
	  font-size: 0.95rem;
	  font-weight: 600;
	  transition: background-color 0.2s ease, color 0.2s ease, transform 0.2s ease;
	}

	.sidebar-menu-link:hover,
	.sidebar-menu-link:focus,
	.sidebar-menu-link.active {
	  background: #092a4b;
	  color: #ffffff;
	  transform: translateX(3px);
	}

	.sidebar-menu-icon {
	  display: inline-block;
	  width: 1.25em;
	  min-width: 1.25em;
	  text-align: center;
	  margin-right: 0.65em;
	  font-size: 1.15em;
	  vertical-align: middle;
	  opacity: 0.88;
	}

	.hero-shell,
	.composer-shell,
	.feed-shell,
	.info-shell {
	  background: var(--panel);
	  border: 1px solid var(--border);
	  border-radius: 18px;
	  box-shadow: var(--shadow);
	}

	.hero-shell { padding: 1.5rem; margin: 1.5rem 0 1rem; }
	.hero-grid {
	  display: grid;
	  grid-template-columns: 1.3fr 0.7fr;
	  gap: 1rem;
	  align-items: stretch;
	}

	.badge {
	  display: inline-flex;
	  align-items: center;
	  gap: 8px;
	  font-size: 0.8rem;
	  font-weight: 800;
	  text-transform: uppercase;
	  letter-spacing: 0.04em;
	  color: #0f3d63;
	  background: #dbeafe;
	  border: 1px solid #bfdbfe;
	  border-radius: 999px;
	  padding: 6px 10px;
	}

	h1, h2, h3 { color: #092a4b; margin-top: 0; }
	h1 { margin: 12px 0 10px; font-size: clamp(1.9rem, 4vw, 3rem); line-height: 1.1; }
	.lead { margin: 0; color: var(--muted); font-size: 1.02rem; max-width: 70ch; }

	.metric-panel {
	  display: grid;
	  gap: 10px;
	  align-content: start;
	}

	.metric {
	  border-radius: 14px;
	  background: linear-gradient(145deg, #0b2a6f, #0284c7);
	  color: #fff;
	  padding: 14px;
	  box-shadow: 0 10px 18px rgba(2, 44, 84, 0.18);
	}

	.metric strong { display: block; font-size: 1.5rem; margin-bottom: 4px; }
	.metric span { font-size: 0.95rem; opacity: 0.96; }

	.section { margin: 1rem 0 1.5rem; }
	.section-header { margin-bottom: 0.9rem; }
	.section-header p { margin: 0; color: var(--muted); }

	.composer-grid {
	  display: grid;
	  grid-template-columns: 1.15fr 0.85fr;
	  gap: 1rem;
	  padding: 1.25rem;
	}

	.panel-card {
	  background: #f8fbff;
	  border: 1px solid #e3ebf5;
	  border-radius: 14px;
	  padding: 1rem;
	}

	.form-grid {
	  display: grid;
	  grid-template-columns: repeat(2, minmax(0, 1fr));
	  gap: 12px;
	}

	.field { display: grid; gap: 6px; }
	.field.full { grid-column: 1 / -1; }
	label { font-size: 0.92rem; font-weight: 700; color: #12304f; }
	input, select, textarea {
	  width: 100%;
	  border: 1px solid #cfd9e6;
	  border-radius: 10px;
	  padding: 11px 12px;
	  font: inherit;
	  color: var(--ink);
	  background: #fff;
	  outline: none;
	  transition: border-color .15s ease, box-shadow .15s ease;
	}
	textarea { min-height: 130px; resize: vertical; }
	input:focus, select:focus, textarea:focus {
	  border-color: #0284c7;
	  box-shadow: 0 0 0 3px rgba(2, 132, 199, 0.12);
	}

	.btn-row {
	  display: flex;
	  flex-wrap: wrap;
	  gap: 10px;
	  margin-top: 14px;
	}

	.btn {
	  display: inline-flex;
	  align-items: center;
	  justify-content: center;
	  gap: 8px;
	  border-radius: 10px;
	  padding: 10px 14px;
	  text-decoration: none;
	  font-weight: 700;
	  border: 1px solid transparent;
	  cursor: pointer;
	  transition: transform .2s ease, box-shadow .2s ease, background .2s ease;
	}
	.btn:hover { transform: translateY(-1px); }
	.btn-primary {
	  color: #fff;
	  background: linear-gradient(135deg, #0284c7, #0b2a6f);
	  box-shadow: 0 10px 24px rgba(47, 123, 255, 0.22);
	}
	.btn-ghost {
	  color: #092a4b;
	  border-color: #cdd8e5;
	  background: #fff;
	}
	.btn-danger {
	  color: #fff;
	  border: none;
	  background: linear-gradient(135deg, #ef4444, #b91c1c);
	}
	.btn-small {
	  border-radius: 8px;
	  padding: 8px 12px;
	  font-size: .9rem;
	  font-weight: 700;
	  border: 1px solid #cdd8e5;
	  color: #092a4b;
	  background: #fff;
	}
	.btn-small.accept {
	  border: none;
	  color: #fff;
	  background: linear-gradient(135deg, #0284c7, #0b2a6f);
	}

	.status-note {
	  min-height: 1.3rem;
	  margin: 12px 0 0;
	  color: var(--muted);
	  word-break: break-word;
	}

	.status-pill {
	  display: inline-flex;
	  align-items: center;
	  gap: 6px;
	  border-radius: 999px;
	  padding: 5px 10px;
	  font-size: .82rem;
	  font-weight: 800;
	  text-transform: uppercase;
	  letter-spacing: .04em;
	}
	.status-draft { background: #fef3c7; color: #92400e; }
	.status-ready { background: #dbeafe; color: #1d4ed8; }
	.status-queued { background: #dbeafe; color: #1d4ed8; }
	.status-published { background: #dcfce7; color: #166534; }
	.status-error { background: #fee2e2; color: #991b1b; }

	.tips-list {
	  margin: 0;
	  padding-left: 18px;
	  color: #334155;
	}
	.tips-list li + li { margin-top: 8px; }

	.feed-toolbar {
	  display: flex;
	  flex-wrap: wrap;
	  gap: 10px;
	  align-items: center;
	  justify-content: space-between;
	  margin-bottom: 12px;
	}

	.feed-filters {
	  display: flex;
	  flex-wrap: wrap;
	  gap: 10px;
	}
	.feed-filters input,
	.feed-filters select {
	  min-width: 220px;
	}

	.jobs-grid {
	  display: grid;
	  grid-template-columns: repeat(2, minmax(0, 1fr));
	  gap: 14px;
	}

	.job-card {
	  background: #fff;
	  border: 1px solid #dbe3ee;
	  border-radius: 16px;
	  padding: 1rem;
	  box-shadow: 0 8px 22px rgba(2, 6, 23, .06);
	  display: grid;
	  gap: 10px;
	}

	.job-card h3 {
	  margin: 0;
	  color: #0b2a6f;
	  font-size: 1.08rem;
	}

	.job-meta {
	  display: flex;
	  flex-wrap: wrap;
	  gap: 8px;
	  color: var(--muted);
	  font-size: .92rem;
	}

	.job-description {
	  margin: 0;
	  color: #334155;
	  white-space: pre-wrap;
	}

	.job-actions {
	  display: flex;
	  flex-wrap: wrap;
	  gap: 8px;
	  align-items: center;
	}

	.info-grid {
	  display: grid;
	  grid-template-columns: repeat(3, minmax(0, 1fr));
	  gap: 14px;
	}

	.info-card {
	  background: linear-gradient(145deg, #ffffff, #f7fbff);
	  border: 1px solid #dbe3ee;
	  border-radius: 16px;
	  padding: 1rem;
	}

	.info-card h3 { margin-bottom: 8px; }
	.info-card p { margin: 0; color: #334155; }

	.cookie-bar {
	  margin: 0 auto 12px;
	  max-width: 1240px;
	  border-radius: 12px;
	  border: 1px solid var(--border);
	  background: rgba(247, 251, 255, 0.98);
	  padding: 12px;
	  display: flex;
	  align-items: center;
	  justify-content: space-between;
	  gap: 10px;
	  flex-wrap: wrap;
	  text-align: center;
	}

	.footer-links {
	  display: flex;
	  justify-content: center;
	  align-items: center;
	  flex-wrap: wrap;
	  gap: 12px;
	  margin-bottom: 10px;
	}

	.footer-links a { color: #64748b; text-decoration: none; }
	.footer-links a:hover { color: #0284c7; }

	@media (max-width: 980px) {
	  .hero-grid,
	  .composer-grid,
	  .jobs-grid,
	  .info-grid,
	  .form-grid {
		grid-template-columns: 1fr;
	  }
	  .sidebar-menu-shell {
		position: static;
		width: 100%;
		max-width: 1240px;
		margin: 12px auto;
	  }
	  .resource-nav, .site-header {
		background: #0B2A6F !important;
		border-bottom: 1px solid #0B2A6F !important;
		backdrop-filter: none !important;
	  }
	}
  </style>
</head>
