<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="theme-color" content="#0b2a6f" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <meta name="robots" content="noindex, follow" />
	<title>Job Requisitions — Impact in Business Recruitment</title>
  <link rel="stylesheet" href="/resource-centre.css" />
  <link rel="stylesheet" href="/index.css" />
  <link rel="stylesheet" href="/mobile-compat.css" />
  <link rel="stylesheet" href="/page-transition.css" />
  <script defer src="https://www.gstatic.com/firebasejs/9.22.2/firebase-app-compat.js"></script>
  <script defer src="https://www.gstatic.com/firebasejs/9.22.2/firebase-auth-compat.js"></script>
  <script defer src="https://www.gstatic.com/firebasejs/9.22.2/firebase-functions-compat.js"></script>
  <script defer src="/firebase-config.js"></script>
  <style>
	:root {
	  --ink: #0f172a;
	  --muted: #5b687a;
	  --border: #dbe3ee;
	  --blue: #0284c7;
	  --navy: #0b2a6f;
	  --shadow: 0 10px 28px rgba(2, 6, 23, 0.08);
	}

	* { box-sizing: border-box; }
	html, body { margin: 0; padding: 0; }
	body {
	  color: var(--ink);
	  background: linear-gradient(180deg, #f5f9ff 0%, #fff 100%);
	  font-family: 'Open Sans', Arial, sans-serif;
	}

	.page-wrapper {
	  min-height: 100vh;
	  max-width: 1920px;
	  margin: 0 auto;
	  background: #fff;
	  box-shadow: 0 0 20px rgba(0, 0, 0, .1);
	}

	.request-shell {
	  width: min(1040px, calc(100% - 2rem));
	  margin: 2rem auto 3rem;
	}

	/* Sidebar menu (shared across member pages) */
	.sidebar-menu-shell {
	  display: none;
	  position: fixed;
	  top: 88px;
	  left: 24px;
	  width: 220px;
	  background: #ffffff;
	  border: 1px solid #dbe3ee;
	  border-radius: 12px;
	  box-shadow: 0 10px 24px rgba(2, 6, 23, 0.12);
	  padding: 10px 0;
	  z-index: 950;
	}

	.sidebar-menu-link {
	  display: block;
	  padding: 11px 14px;
	  margin: 2px 8px;
	  border-radius: 8px;
	  color: #092a4b;
	  text-decoration: none;
	  font-size: 0.95rem;
	  font-weight: 600;
	  transition: background-color 0.2s ease, color 0.2s ease, transform 0.2s ease;
	}

	.sidebar-menu-link:hover,
	.sidebar-menu-link:focus,
	.sidebar-menu-link.active {
	  background: #092a4b;
	  color: #ffffff;
	  transform: translateX(3px);
	}

	.sidebar-menu-icon {
	  display: inline-block;
	  width: 1.25em;
	  min-width: 1.25em;
	  text-align: center;
	  margin-right: 0.65em;
	  font-size: 1.15em;
	  vertical-align: middle;
	  opacity: 0.88;
	}

	body.has-sidebar #requestShell { margin-left: 260px; }

	.intro-card,
	.request-card,
	.auth-card {
	  border: 1px solid var(--border);
	  border-radius: 18px;
	  background: #fff;
	  box-shadow: var(--shadow);
	}

	@media (max-width: 980px) {
	  .sidebar-menu-shell {
		position: static;
		width: 100%;
		max-width: 900px;
		margin: 12px auto;
	  }
	  body.has-sidebar #requestShell { margin-left: auto; }
	}

	.intro-card {
	  padding: clamp(1.25rem, 4vw, 2.25rem);
	  margin-bottom: 1.25rem;
	  background: linear-gradient(145deg, #fff 0%, #f2f8ff 100%);
	}

	.eyebrow {
	  display: inline-flex;
	  border-radius: 999px;
	  padding: 6px 11px;
	  color: #0f3d63;
	  background: #dbeafe;
	  border: 1px solid #bfdbfe;
	  font-size: .8rem;
	  font-weight: 800;
	  letter-spacing: .04em;
	  text-transform: uppercase;
	}

	h1, h2, h3 { color: #092a4b; }
	h1 { margin: 12px 0 8px; font-size: clamp(1.9rem, 4vw, 2.8rem); line-height: 1.14; }
	.intro-card p { max-width: 72ch; margin: 0; color: var(--muted); }

	.auth-card {
	  display: none;
	  max-width: 760px;
	  margin: 2rem auto;
	  padding: 2rem;
	  text-align: center;
	  background: linear-gradient(145deg, #fff 0%, #f6fbff 100%);
	}

	.request-card { padding: clamp(1rem, 3vw, 1.75rem); }
	.request-card h2 { margin: 0 0 6px; }
	.form-intro { margin: 0 0 1.25rem; color: var(--muted); }

	.form-grid {
	  display: grid;
	  grid-template-columns: repeat(2, minmax(0, 1fr));
	  gap: 14px;
	}

	.field { display: grid; gap: 6px; }
	.field.full { grid-column: 1 / -1; }
	label { color: #12304f; font-size: .92rem; font-weight: 700; }
	.required { color: #b91c1c; }
	input, select, textarea {
	  width: 100%;
	  padding: 11px 12px;
	  border: 1px solid #cfd9e6;
	  border-radius: 10px;
	  color: var(--ink);
	  background: #fff;
	  font: inherit;
	  outline: none;
	  transition: border-color .15s ease, box-shadow .15s ease;
	}
	textarea { min-height: 132px; resize: vertical; }
	input:focus, select:focus, textarea:focus {
	  border-color: var(--blue);
	  box-shadow: 0 0 0 3px rgba(2, 132, 199, .12);
	}
	.field-hint { color: var(--muted); font-size: .82rem; }

	.form-footer {
	  display: flex;
	  align-items: center;
	  gap: 14px;
	  flex-wrap: wrap;
	  margin-top: 18px;
	}

	.submit-button, .sign-in-button {
	  display: inline-flex;
	  align-items: center;
	  justify-content: center;
	  min-height: 44px;
	  padding: 10px 18px;
	  border: 0;
	  border-radius: 10px;
	  color: #fff;
	  background: linear-gradient(135deg, var(--blue), var(--navy));
	  box-shadow: 0 8px 18px rgba(2, 44, 84, .18);
	  font: inherit;
	  font-weight: 700;
	  text-decoration: none;
	  cursor: pointer;
	  transition: transform .2s ease, opacity .2s ease;
	}
	.submit-button:hover, .sign-in-button:hover { transform: translateY(-1px); }
	.submit-button:disabled { cursor: wait; opacity: .65; transform: none; }
	.form-status { min-height: 1.4rem; margin: 0; color: var(--muted); }
	.form-status.success { color: #166534; }
	.form-status.error { color: #b91c1c; }

	.privacy-note { margin: 14px 0 0; color: var(--muted); font-size: .88rem; }

	@media (max-width: 900px) {
	  .resource-nav, .site-header {
		background: #0B2A6F !important;
		border-bottom: 1px solid #0B2A6F !important;
		backdrop-filter: none !important;
	  }
	}

	@media (max-width: 640px) {
	  .form-grid { grid-template-columns: 1fr; }
	  .field.full { grid-column: auto; }
	  .form-footer { align-items: stretch; }
	  .submit-button { width: 100%; }
	}
  </style>
</head>
<body class="auth-pending">
  <div class="page-wrapper">
	<header class="resource-nav" role="banner">
	  <div class="container container-nav">
		<div class="logo" style="display:flex;align-items:center;gap:12px">
		  <a href="/index.html" aria-label="Impact in Business Recruitment home">
			<img src="/160.jpg" alt="Impact logo" class="site-logo" style="height:36px;width:auto;display:block" />
		  </a>
		  <span class="site-title" style="color:lightgrey">Job Requests</span>
		</div>
		<div class="user-menu" style="margin-left:auto;display:flex;align-items:center;gap:12px">
		  <div class="auth-profile-chip" data-auth-profile>
			<img class="auth-profile-photo" data-auth-photo src="/100.png" alt="Profile photo" />
			<span class="auth-profile-name" data-auth-name></span>
		  </div>
		  <a class="btn btn-outline nav-login" href="/login.html" id="signInLink">Sign In</a>
		  <button class="btn btn-outline" id="signOutBtn" type="button" style="display:none">Sign Out</button>
		</div>
	  </div>
	</header>
	<nav id="topNavMenu" class="sidebar-menu-shell" aria-label="Members navigation">
	  <a class="sidebar-menu-link" href="https://www.ibrecruitment.com"><span class="sidebar-menu-icon" aria-hidden="true">🏠</span> Home</a>
	  <a class="sidebar-menu-link" href="/editprofile.html"><span class="sidebar-menu-icon" aria-hidden="true">👤</span> Edit Profile</a>
	  <a class="sidebar-menu-link" href="/members.html"><span class="sidebar-menu-icon" aria-hidden="true">🧑‍🤝‍🧑</span> Members Area</a>
	  <a class="sidebar-menu-link" href="/insights.html"><span class="sidebar-menu-icon" aria-hidden="true">💡</span> Insights Archive</a>
	  <a class="sidebar-menu-link" href="/uploads.html"><span class="sidebar-menu-icon" aria-hidden="true">📤</span> Resume Uploads</a>
	  <a class="sidebar-menu-link active" href="/requests.html" aria-current="page"><span class="sidebar-menu-icon" aria-hidden="true">📋</span> Job Requisitions</a>
	  <a class="sidebar-menu-link" href="/settings.html"><span class="sidebar-menu-icon" aria-hidden="true">⚙️</span> Account Settings</a>
	  <a class="sidebar-menu-link" href="https://editor.ibrecruitment.com/claude.html" target="_blank" rel="noopener noreferrer"><span class="sidebar-menu-icon" aria-hidden="true">🤖</span> Ask Claude Code</a>
	  <a class="sidebar-menu-link" href="https://www.ibrecruitment.com/contact" target="_blank" rel="noopener noreferrer"><span class="sidebar-menu-icon" aria-hidden="true">✉️</span> Contact Sales</a>
	  <a class="sidebar-menu-link" href="/directory.html"><span class="sidebar-menu-icon" aria-hidden="true">📇</span> Member Directory</a>
	</nav>
	<script>
	  // Show/hide sidebar menu based on authentication
	  function updateSidebarVisibility() {
		var sidebar = document.getElementById('topNavMenu');
		if (document.body.classList.contains('has-sidebar')) {
		  sidebar.style.display = 'block';
		} else {
		  sidebar.style.display = 'none';
		}
	  }
	  document.addEventListener('DOMContentLoaded', updateSidebarVisibility);
	  var observer = new MutationObserver(updateSidebarVisibility);
	  observer.observe(document.body, { attributes: true, attributeFilter: ['class'] });
	</script>

	<section id="loginSection" class="auth-card">
	  <h1>Job Requisitions</h1>
	  <p>Sign in with your account to submit a hiring request. Your submission will be emailed to the recruitment team.</p>
	  <a class="sign-in-button" href="/login.html">Go to Sign In</a>
	</section>

	<main id="requestShell" class="request-shell" style="display:none" role="main">
	  <section class="intro-card">
		<span class="eyebrow">Hiring request</span>
		<h1>Submit a job requisition</h1>
		<p>Share the role requirements and hiring context. We’ll send the completed request to the recruitment team for review.</p>
	  </section>

	  <section class="request-card" aria-labelledby="requestTitle">
		<h2 id="requestTitle">Requisition details</h2>
		<p class="form-intro">Fields marked with <span class="required">*</span> are required.</p>
		<form id="requisitionForm" autocomplete="on">
		  <div class="form-grid">
			<div class="field">
			  <label for="jobTitle">Job title <span class="required">*</span></label>
			  <input id="jobTitle" name="jobTitle" type="text" maxlength="160" required />
			</div>
			<div class="field">
			  <label for="department">Department / team <span class="required">*</span></label>
			  <input id="department" name="department" type="text" maxlength="120" required />
			</div>
			<div class="field">
			  <label for="hiringManager">Hiring manager <span class="required">*</span></label>
			  <input id="hiringManager" name="hiringManager" type="text" maxlength="120" required />
			</div>
			<div class="field">
			  <label for="workLocation">Work location <span class="required">*</span></label>
			  <input id="workLocation" name="workLocation" type="text" maxlength="160" placeholder="City, country or remote" required />
			</div>
			<div class="field">
			  <label for="workplaceType">Work arrangement <span class="required">*</span></label>
			  <select id="workplaceType" name="workplaceType" required>
				<option value="">Select arrangement</option>
				<option value="On-site">On-site</option>
				<option value="Hybrid">Hybrid</option>
				<option value="Remote">Remote</option>
			  </select>
			</div>
			<div class="field">
			  <label for="employmentType">Employment type <span class="required">*</span></label>
			  <select id="employmentType" name="employmentType" required>
				<option value="">Select employment type</option>
				<option value="Full-time">Full-time</option>
				<option value="Part-time">Part-time</option>
				<option value="Contract">Contract</option>
				<option value="Temporary">Temporary</option>
				<option value="Internship">Internship</option>
			  </select>
			</div>
			<div class="field">
			  <label for="numberOfOpenings">Number of openings <span class="required">*</span></label>
			  <input id="numberOfOpenings" name="numberOfOpenings" type="number" min="1" max="500" step="1" value="1" required />
			</div>
			<div class="field">
			  <label for="targetStartDate">Target start date</label>
			  <input id="targetStartDate" name="targetStartDate" type="date" />
			</div>
			<div class="field">
			  <label for="salaryRange">Salary range</label>
			  <input id="salaryRange" name="salaryRange" type="text" maxlength="120" placeholder="Include currency and period" />
			</div>
			<div class="field">
			  <label for="urgency">Hiring priority <span class="required">*</span></label>
			  <select id="urgency" name="urgency" required>
				<option value="">Select priority</option>
				<option value="Standard">Standard</option>
				<option value="High">High</option>
				<option value="Urgent">Urgent</option>
			  </select>
			</div>
			<div class="field">
			  <label for="budgetApproved">Budget approved <span class="required">*</span></label>
			  <select id="budgetApproved" name="budgetApproved" required>
				<option value="">Select one</option>
				<option value="Yes">Yes</option>
				<option value="No">No</option>
				<option value="Pending">Pending</option>
			  </select>
			</div>
			<div class="field">
			  <label for="applicationUrl">Application / role link</label>
			  <input id="applicationUrl" name="applicationUrl" type="url" maxlength="500" placeholder="https://..." />
			</div>
			<div class="field full">
			  <label for="jobDescription">Role summary and responsibilities <span class="required">*</span></label>
			  <textarea id="jobDescription" name="jobDescription" maxlength="6000" required></textarea>
			  <span class="field-hint">Include the key outcomes and responsibilities for the role.</span>
			</div>
			<div class="field full">
			  <label for="requirements">Required experience and qualifications</label>
			  <textarea id="requirements" name="requirements" maxlength="4000"></textarea>
			</div>
			<div class="field full">
			  <label for="additionalNotes">Additional notes</label>
			  <textarea id="additionalNotes" name="additionalNotes" maxlength="3000" placeholder="Approval context, preferred timeline, or other relevant information."></textarea>
			</div>
		  </div>
		  <div class="form-footer">
			<button class="submit-button" id="submitButton" type="submit">Submit requisition</button>
			<p class="form-status" id="formStatus" aria-live="polite"></p>
		  </div>
		  <p class="privacy-note">Your account email will be included as the requester so the recruitment team can follow up.</p>
		</form>
	  </section>
	</main>
  </div>

  <script>
	window.addEventListener('DOMContentLoaded', function () {
	  if (!window.firebase || !window.firebaseConfig) return;
	  try { firebase.initializeApp(window.firebaseConfig); } catch (error) {}

	  var auth = firebase.auth();
	  var loginSection = document.getElementById('loginSection');
	  var requestShell = document.getElementById('requestShell');
	  var signInLink = document.getElementById('signInLink');
	  var signOutBtn = document.getElementById('signOutBtn');
	  var form = document.getElementById('requisitionForm');
	  var submitButton = document.getElementById('submitButton');
	  var formStatus = document.getElementById('formStatus');

	  function setStatus(message, type) {
		formStatus.textContent = message || '';
		formStatus.className = 'form-status' + (type ? ' ' + type : '');
	  }

	  function getFormData() {
		return {
		  jobTitle: document.getElementById('jobTitle').value.trim(),
		  department: document.getElementById('department').value.trim(),
		  hiringManager: document.getElementById('hiringManager').value.trim(),
		  workLocation: document.getElementById('workLocation').value.trim(),
		  workplaceType: document.getElementById('workplaceType').value,
		  employmentType: document.getElementById('employmentType').value,
		  numberOfOpenings: Number(document.getElementById('numberOfOpenings').value),
		  targetStartDate: document.getElementById('targetStartDate').value,
		  salaryRange: document.getElementById('salaryRange').value.trim(),
		  urgency: document.getElementById('urgency').value,
		  budgetApproved: document.getElementById('budgetApproved').value,
		  applicationUrl: document.getElementById('applicationUrl').value.trim(),
		  jobDescription: document.getElementById('jobDescription').value.trim(),
		  requirements: document.getElementById('requirements').value.trim(),
		  additionalNotes: document.getElementById('additionalNotes').value.trim()
		};
	  }

	  auth.onAuthStateChanged(function (user) {
		document.body.classList.remove('auth-pending');
		if (user) {
		  document.body.classList.add('has-sidebar');
		  loginSection.style.display = 'none';
		  requestShell.style.display = 'block';
		  signInLink.style.display = 'none';
		  signOutBtn.style.display = 'inline-flex';
		} else {
		  document.body.classList.remove('has-sidebar');
		  loginSection.style.display = 'block';
		  requestShell.style.display = 'none';
		  signInLink.style.display = 'inline-flex';
		  signOutBtn.style.display = 'none';
		}
	  });

	  signOutBtn.addEventListener('click', function () {
		auth.signOut();
	  });

	  form.addEventListener('submit', async function (event) {
		event.preventDefault();
		if (!form.reportValidity()) return;
		submitButton.disabled = true;
		setStatus('Sending your requisition…', '');

		try {
		  var submitRequest = firebase.functions().httpsCallable('submitJobRequisition');
		  await submitRequest(getFormData());
		  form.reset();
		  setStatus('Requisition submitted. The recruitment team has been notified.', 'success');
		} catch (error) {
		  console.error('Job requisition submission failed:', error);
		  setStatus(error.message || 'Unable to submit your requisition. Please try again.', 'error');
		} finally {
		  submitButton.disabled = false;
		}
	  });
	});
  </script>
</body>
</html>