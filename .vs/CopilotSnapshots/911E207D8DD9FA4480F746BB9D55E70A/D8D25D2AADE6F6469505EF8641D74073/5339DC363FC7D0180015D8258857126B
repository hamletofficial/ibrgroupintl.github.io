	<script>
	  function updateSidebarVisibility() {
		var sidebar = document.getElementById('topNavMenu');
		if (document.body.classList.contains('has-sidebar')) {
		  sidebar.style.display = 'block';
		} else {
		  sidebar.style.display = 'none';
		}
	  }
	  document.addEventListener('DOMContentLoaded', updateSidebarVisibility);
	  var observer = new MutationObserver(updateSidebarVisibility);
	  observer.observe(document.body, { attributes: true, attributeFilter: ['class'] });
	</script>

	<section id="loginSection" class="auth-shell">
	  <h1 style="margin:0;color:#092a4b">LinkedIn Live Feed</h1>
	  <p style="margin:.75rem 0 1.25rem;color:var(--muted)">Sign in to create job adverts, save drafts, and prepare listings for manual posting to LinkedIn.</p>
	  <a class="btn btn-primary" href="/login.html">Go to Sign In</a>
	  <p style="margin:1rem 0 0;color:#64748b;font-size:.95rem">LinkedIn posting is completed manually by an authorized company page administrator.</p>
	</section>

	<main id="liveShell" class="live-shell" role="main">
	  <section class="hero-shell section">
		<div class="hero-grid">
		  <div>
			<span class="badge">Manual LinkedIn Posting</span>
			<h1>Prepare job adverts in one live feed, then post them to LinkedIn manually.</h1>
			<p class="lead">Create, review, and store job listings in the authenticated feed. When ready, copy the advert into your LinkedIn Company Page and mark it as posted here.</p>
		  </div>
		  <aside class="metric-panel" aria-label="Live feed metrics">
			<div class="metric"><strong id="metricTotal">0</strong><span>Total adverts in the feed</span></div>
			<div class="metric"><strong id="metricReady">0</strong><span>Ready for manual posting</span></div>
			<div class="metric"><strong id="metricDrafts">0</strong><span>Drafts saved by logged-in users</span></div>
		  </aside>
		</div>
	  </section>

	  <section class="section composer-shell">
		<div class="composer-grid">
		  <div>
			<div class="section-header">
			  <h2>Post a job advert</h2>
			  <p>Save a draft or add the completed advert to the feed as ready for manual posting.</p>
			</div>
			<form id="jobForm" autocomplete="off">
			  <div class="form-grid">
				<div class="field">
				  <label for="jobTitle">Job title</label>
				  <input id="jobTitle" name="jobTitle" type="text" placeholder="Senior Recruiter" required />
				</div>
				<div class="field">
				  <label for="companyName">Company name</label>
				  <input id="companyName" name="companyName" type="text" placeholder="Your company name" required />
				</div>
				<div class="field">
				  <label for="location">Location</label>
				  <input id="location" name="location" type="text" placeholder="London, UK" required />
				</div>
				<div class="field">
				  <label for="employmentType">Employment type</label>
				  <select id="employmentType" name="employmentType" required>
					<option value="">Select one</option>
					<option>Full-time</option>
					<option>Part-time</option>
					<option>Contract</option>
					<option>Temporary</option>
					<option>Internship</option>
				  </select>
				</div>
				<div class="field">
				  <label for="workplaceType">Workplace type</label>
				  <select id="workplaceType" name="workplaceType" required>
					<option value="">Select one</option>
					<option>On-site</option>
					<option>Hybrid</option>
					<option>Remote</option>
				  </select>
				</div>
				<div class="field">
				  <label for="applyUrl">Apply URL</label>
				  <input id="applyUrl" name="applyUrl" type="url" placeholder="https://..." />
				</div>
				<div class="field">
				  <label for="salaryRange">Salary range</label>
				  <input id="salaryRange" name="salaryRange" type="text" placeholder="£45k - £55k" />
				</div>
				<div class="field full">
				  <label for="jobDescription">Job description</label>
				  <textarea id="jobDescription" name="jobDescription" placeholder="Outline responsibilities, requirements, and benefits." required></textarea>
				</div>
				<div class="field full">
				  <label for="postingNotes">Posting notes</label>
				  <textarea id="postingNotes" name="postingNotes" placeholder="Optional internal notes, screening rules, or approval comments."></textarea>
				</div>
			  </div>
			  <div class="btn-row">
				<button type="button" class="btn btn-ghost" id="saveDraftBtn">Save Draft</button>
				<button type="submit" class="btn btn-primary" id="publishBtn">Add as Ready to Post</button>
				<button type="reset" class="btn btn-danger">Clear Form</button>
			  </div>
			  <p id="formStatus" class="status-note" aria-live="polite"></p>
			</form>
		  </div>
		  <aside class="panel-card">
		  <h3>Manual posting checklist</h3>
			<ul class="tips-list">
			<li>Review the title, location, employment type, and description before posting.</li>
			<li>Open LinkedIn and post the advert through your Company Page using an authorized account.</li>
			<li>Include the application link and salary range in the LinkedIn advert when appropriate.</li>
			<li>After posting, return here and select “Mark as Posted” on the listing.</li>
			</ul>
		  </aside>
		</div>
	  </section>

	  <section class="section info-shell">
		<div class="section-header" style="padding:1.25rem 1.25rem 0;">
		  <h2>Manual posting workflow</h2>
		  <p>Use the feed to prepare and track adverts; LinkedIn publication is a separate manual step.</p>
		</div>
		<div class="info-grid" style="padding:0 1.25rem 1.25rem;">
		  <div class="info-card">
			<h3>1. Create the advert</h3>
			<p>Enter the role, company, location, salary, and job description. Save as a draft if it needs review.</p>
		  </div>
		  <div class="info-card">
			<h3>2. Post on LinkedIn</h3>
			<p>Copy the advert details and publish it using an authorized LinkedIn Company Page account.</p>
		  </div>
		  <div class="info-card">
			<h3>3. Track status</h3>
			<p>Track which adverts are drafts, ready to post, or manually marked as posted.</p>
		  </div>
		</div>
	  </section>

	  <section class="section feed-shell">
		<div style="padding:1.25rem;">
		  <div class="feed-toolbar">
			<div class="section-header" style="margin-bottom:0;">
			  <h2 style="margin-bottom:4px;">Live job adverts</h2>
				<p>Firestore-backed feed of drafts, ready-to-post adverts, and manually posted jobs.</p>
			</div>
			<div class="feed-filters" aria-label="Feed filters">
			  <input id="searchInput" type="search" placeholder="Search title, company, or location" />
			  <select id="statusFilter">
				<option value="all">All statuses</option>
				<option value="draft">Drafts</option>
				<option value="ready">Ready to post</option>
				<option value="published">Published</option>
			  </select>
			</div>
		  </div>
		  <div id="jobsGrid" class="jobs-grid"></div>
		  <p id="jobsEmptyState" class="status-note" style="text-align:center; margin:1rem 0 0;">No job adverts yet. Sign in and add the first one.</p>
		</div>
	  </section>

	  <section class="section info-shell">
		<div style="padding:1.25rem;">
		  <div class="section-header">
			<h2>Why this page works well for LinkedIn Jobs</h2>
			<p>It stores advert content securely and leaves LinkedIn publishing to an authorized human operator.</p>
		  </div>
		  <div class="info-grid">
			<div class="info-card">
			  <h3>Secure by design</h3>
			  <p>Only authenticated users can create adverts, and signed-in members can review the live feed.</p>
			</div>
			<div class="info-card">
			  <h3>Operational visibility</h3>
			  <p>Recruiters see draft, ready-to-post, and manually posted states without leaving the dashboard.</p>
			</div>
			<div class="info-card">
			  <h3>LinkedIn-aware</h3>
			  <p>The page keeps the information needed to compose a Company Page advert, without connecting to LinkedIn APIs.</p>
			</div>
		  </div>
		</div>
	  </section>

	  <div id="cookieConsentBar" class="cookie-bar">
		<div>
		  This website uses cookies to improve your experience.
		  <a href="/cookies.html" style="color:#0b2a6f">Cookie Policy</a>
		  <span aria-hidden="true">|</span>
		  <a href="/privacy.html" style="color:#0b2a6f">Privacy Policy</a>
		</div>
		<div style="display:inline-flex;gap:8px;flex-wrap:wrap;">
		  <button id="cookieDeclineBtn" class="btn-small" type="button">Decline</button>
		  <button id="cookieAcceptBtn" class="btn-small accept" type="button">Accept</button>
		</div>
	  </div>
	</main>

