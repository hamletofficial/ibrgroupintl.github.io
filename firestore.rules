        && request.resource.data.id == searchId
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 1
        && request.resource.data.name.size() <= 80
        && request.resource.data.query is string
        && request.resource.data.query.size() <= 100
        && request.resource.data.stage in ['', 'Initial Inspection','LOI Issued','Due Diligence','Under Contract','Lease Execution','Closing','Commission Payout','Closed']
        && request.resource.data.type in ['', 'Acquisition','Disposal','Leasing','Investment','Development']
        && request.resource.data.alertsEnabled is bool
        && request.resource.data.lastMatchedIds is list
        && request.resource.data.lastMatchedIds.size() <= 500
        && request.resource.data.updatedAt == request.time;
      allow delete: if request.auth != null && resource.data.uid == request.auth.uid;
    }

    // Search analytics events: bounded, minimally identifying client-submitted records.
    // Reads are granted only to the designated super administrator by the catch-all rule below.
    match /searchAnalyticsEvents/{eventId} {
      allow create: if (
        request.resource.data.keys().hasAll(['query','area','path','uid','createdAt'])
        && request.resource.data.keys().hasOnly(['query','area','path','uid','createdAt'])
        && request.resource.data.query is string
        && request.resource.data.query.size() >= 2
        && request.resource.data.query.size() <= 100
        && request.resource.data.area is string
        && request.resource.data.area.size() <= 80
        && request.resource.data.path is string
        && request.resource.data.path.size() <= 160
        && request.resource.data.uid == null
        && request.resource.data.createdAt == request.time
      ) || (
        request.auth != null
        && request.resource.data.keys().hasAll(['query','area','path','uid','createdAt'])
        && request.resource.data.keys().hasOnly(['query','area','path','uid','createdAt'])
        && request.resource.data.query is string
        && request.resource.data.query.size() >= 2
        && request.resource.data.query.size() <= 100
        && request.resource.data.area is string
        && request.resource.data.area.size() <= 80
