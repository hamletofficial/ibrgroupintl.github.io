<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <title>Enterprise Login — Human Resource Centre</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700&display=swap" rel="stylesheet">
  <style>
    :root{--bg:#f4f6f8;--card:#ffffff;--muted:#6b7280;--accent:#0f62fe;--border:#e6eef8}
    *{box-sizing:border-box}
    html,body{height:100%}
    body{margin:0;font-family:Inter,system-ui,-apple-system,Segoe UI,Roboto,Arial;background:var(--bg);color:#0f1724;display:flex;align-items:center;justify-content:center;padding:32px}
    .login-wrapper{max-width:420px;width:100%}
    .login-card{background:var(--card);padding:32px;border-radius:12px;border:1px solid var(--border);box-shadow:0 8px 30px rgba(2,6,23,0.06);text-align:center}
    .brand-logo{height:48px;width:auto;margin-bottom:14px}
    h1{margin:0;font-size:1.5rem}
    p.lead{color:var(--muted);margin-top:8px;margin-bottom:20px}
    form{display:flex;flex-direction:column;gap:12px}
    label{display:block;text-align:left}
    input[type="text"],input[type="password"]{width:100%;padding:12px 14px;border:1px solid #dbe7ff;border-radius:8px;font-size:0.98rem;background:#fcfeff}
    .form-row{display:flex;justify-content:space-between;align-items:center;gap:12px}
    .remember{display:flex;align-items:center;gap:8px;color:var(--muted);font-size:0.95rem}
    .actions{display:flex;flex-direction:column;gap:10px;margin-top:6px}
    .btn-primary{background:var(--accent);color:#fff;padding:12px;border-radius:8px;border:none;font-weight:600;cursor:pointer}
    .btn-secondary{background:transparent;border:1px solid var(--border);padding:10px;border-radius:8px;color:var(--muted);cursor:pointer;text-decoration:none;display:inline-block}
    .footer-note{margin-top:18px;font-size:0.88rem;color:var(--muted)}
    .error{color:#b00020;font-size:0.95rem;margin-bottom:6px;text-align:left}
    .sr-only{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);border:0}
    @media (max-width:480px){body{padding:18px}.login-card{padding:20px}}
  </style>
</head>
<body>
  <main class="login-wrapper" role="main">
    <section class="login-card" aria-labelledby="login-heading">
      <div class="brand-text" aria-hidden="true" style="font-weight:700;color:var(--accent);margin-bottom:10px">Impact in Business Recruitment</div>
      <h1 id="login-heading">Enterprise Login</h1>
      <p class="lead">Secure access to the Human Resource Centre</p>

      <% if (typeof error !== 'undefined' && error) { %>
        <div class="error" role="alert"><%= error %></div>
      <% } %>

      <form method="post" action="/login" autocomplete="off" novalidate>
        <label>
          <span class="sr-only">Username</span>
          <input name="username" type="text" required placeholder="Username" maxlength="100" autofocus>
        </label>

        <label>
          <span class="sr-only">Password</span>
          <input name="password" type="password" required placeholder="Password" autocomplete="current-password">
        </label>

        <div class="form-row">
          <label class="remember"><input type="checkbox" name="remember" value="1"> Remember me</label>
          <a href="/forgot" style="color:var(--accent);font-size:0.95rem;text-decoration:none">Forgot?</a>
        </div>

        <div class="actions">
          <button type="submit" class="btn-primary">Sign in</button>
          <a class="btn-secondary" href="/">Return to site</a>
          <a class="btn-primary" href="/auth/google" style="display:flex;align-items:center;justify-content:center;gap:8px;background:#db4437;border:none"> 
            <svg width="18" height="18" viewBox="0 0 533.5 544.3" aria-hidden="true" focusable="false">
              <path fill="#4285F4" d="M533.5 278.4c0-18.5-1.5-37.1-4.7-55.3H272v104.8h146.9c-6.4 34.7-26.1 64.1-55.7 83.7v69.4h90c52.9-48.7 83.3-120.6 83.3-202.6z"/>
              <path fill="#34A853" d="M272 544.3c74.4 0 136.9-24.6 182.6-66.7l-90-69.4c-25 16.8-57 26.8-92.6 26.8-71 0-131.1-48-152.6-112.5h-95.5v70.8C86.6 487.2 173.9 544.3 272 544.3z"/>
              <path fill="#FBBC05" d="M119.4 323.6c-10.8-32.3-10.8-66.8 0-99.1V153.7h-95.5C6.1 205.6 0 239.5 0 272.5s6.1 66.9 23.9 118.9l95.5-68z"/>
              <path fill="#EA4335" d="M272 107.7c39.3 0 74.6 13.6 102.5 40.6l76.9-76.9C408.9 24.6 346.4 0 272 0 173.9 0 86.6 57.1 43.8 141.6l95.5 70.8C140.9 155.7 201 107.7 272 107.7z"/>
            </svg>
            <span>Sign in with Google</span>
          </a>
        </div>

        <div class="footer-note">By signing in you agree to our terms and privacy policy.</div>
      </form>
    </section>
  </main>
  <script src="/hamlet-background.js?v=20261013-1"></script>
</body>
</html>
