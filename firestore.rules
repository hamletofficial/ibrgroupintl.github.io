    // Hamlet transaction history is append-only for authenticated clients.
    // Server administrators can retain/export these events independently.
    // History entries are created only by the trusted Cloud Function.
    // Authenticated owners can read their own records; clients cannot alter them.
    match /hamletDealEvents/{eventId} {
      allow read: if request.auth != null && resource.data.uid == request.auth.uid;
      allow create, update, delete: if false;
    }

    // Immutable audit events are written by trusted Cloud Functions only.
    // Super-admins can inspect platform-wide history; members can read their own.
    match /hamletDealEvents/{eventId} {
      allow read: if request.auth != null
        && (request.auth.token.email == 'uk-hr-enquiries@ibrecruitment.com'
          && request.auth.token.email_verified == true
          || resource.data.uid == request.auth.uid);
      allow create, update, delete: if false;
    }

    match /hamletPropertyEvents/{eventId} {
      allow read: if request.auth != null
        && (request.auth.token.email == 'uk-hr-enquiries@ibrecruitment.com'
          && request.auth.token.email_verified == true
          || resource.data.uid == request.auth.uid);
