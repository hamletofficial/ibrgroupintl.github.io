rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /publicProfiles/{userId} {
      // Members must always be able to read their own saved profile for authenticated headers/settings, even when their profile is not public.
      allow read: if request.auth != null
        && (request.auth.uid == userId || resource.data.isPublic == true);

      // Clients cannot claim successful Onfido verification. A trusted server
      // using the Admin SDK must set onfidoVerified after verification.
      allow create: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.isPublic == true
        && (!('onfidoVerified' in request.resource.data)
          || request.resource.data.onfidoVerified == false);

      // Clients may edit other profile fields, but cannot add, change, or remove
      // the identity-verification flag.
      allow update: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.isPublic == true
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['onfidoVerified']);

      allow delete: if request.auth != null && request.auth.uid == userId;
    }

    match /directMessages/{messageId} {
      allow read: if request.auth != null
        && request.auth.uid in resource.data.participants;

      allow create: if request.auth != null
        && request.resource.data.senderUid == request.auth.uid
        && request.resource.data.recipientUid is string
        && request.resource.data.recipientUid != request.auth.uid
        && request.resource.data.participants is list
        && request.resource.data.participants.size() == 2
        && request.auth.uid in request.resource.data.participants
        && request.resource.data.recipientUid in request.resource.data.participants
        && request.resource.data.body is string
        && request.resource.data.body.size() >= 1
        && request.resource.data.body.size() <= 5000
        && request.resource.data.sentAt == request.time
        && request.resource.data.pinnedBy is list
        && request.resource.data.readBy is list
        && (!('attachments' in request.resource.data)
          || (request.resource.data.attachments is list
            && request.resource.data.attachments.size() <= 5));

      // Participants must be Firebase-authenticated to update conversation metadata.
      // Only the authenticated sender may anonymise their own message.
      allow update: if request.auth != null
        && request.auth.uid in resource.data.participants
        && (
          (
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['pinnedBy','readBy'])
            && request.resource.data.pinnedBy is list
            && request.resource.data.readBy is list
          )
          ||
          (
            request.auth.uid == resource.data.senderUid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['attachments'])
            && request.resource.data.attachments is list
            && request.resource.data.attachments.size() <= 5
          )
          ||
          (
            request.auth.uid == resource.data.senderUid
            && (!('anonymised' in resource.data) || resource.data.anonymised != true)
            && request.resource.data.diff(resource.data).affectedKeys().hasAll(['body','anonymised','anonymisedAt'])
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['body','anonymised','anonymisedAt'])
            && request.resource.data.body == '[Message anonymised]'
            && request.resource.data.anonymised == true
            && request.resource.data.anonymisedAt == request.time
          )
        );

      // Either authenticated participant may delete a message when removing their conversation.
      allow delete: if request.auth != null
        && request.auth.uid in resource.data.participants;
    }

    // Each authenticated user has a private archive of conversation threads.
    match /userMessageArchives/{userId}/conversations/{conversationId} {
      allow read, delete: if request.auth != null
        && request.auth.uid == userId;
      allow create, update: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.ownerUid == userId
        && request.resource.data.otherUid == conversationId
        && request.resource.data.archivedAt == request.time;
    }

    // Each member controls their own blocked-member list. A blocked recipient can read
    // only the specific record that indicates whether they are blocked by that member.
    match /userMessageBlocks/{userId}/blockedUsers/{otherUid} {
      allow read: if request.auth != null
        && (request.auth.uid == userId || request.auth.uid == otherUid);
      allow create, update: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.blockedUid == otherUid
        && request.resource.data.blockedAt == request.time;
      allow delete: if request.auth != null
        && request.auth.uid == userId;
    }

    // Members can manage their own private Important flags for mailbox messages.
    match /userMessageFlags/{userId}/flaggedMessages/{messageId} {
      allow read, delete: if request.auth != null
        && request.auth.uid == userId;
      allow create, update: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.messageId == messageId;
    }

    match /insightsFeed/{insightId} {
      allow read: if request.auth != null;
      allow create, update, delete: if false;
    }

    match /commercialProperties/{propertyId} {
      // Only members whose publicProfiles record confirms completed identity verification
      // may publish a commercial property listing.
      allow create: if request.auth != null
        && request.resource.data.ownerUid == request.auth.uid
        && exists(/databases/$(database)/documents/publicProfiles/$(request.auth.uid))
        && get(/databases/$(database)/documents/publicProfiles/$(request.auth.uid)).data.onfidoVerified == true;
      allow read: if request.auth != null;
      allow update: if request.auth != null
        && resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerUid == request.auth.uid
        && exists(/databases/$(database)/documents/publicProfiles/$(request.auth.uid))
        && get(/databases/$(database)/documents/publicProfiles/$(request.auth.uid)).data.onfidoVerified == true;
      allow delete: if request.auth != null
        && resource.data.ownerUid == request.auth.uid;
    }

    match /brokerReviews/{reviewId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 1
        && request.resource.data.name.size() <= 120
        && request.resource.data.review is string
        && request.resource.data.review.size() >= 1
        && request.resource.data.review.size() <= 3000
        && request.resource.data.rating is int
        && request.resource.data.rating >= 1
        && request.resource.data.rating <= 5;
      allow update, delete: if false;
    }

    match /callbackRequests/{requestId} {
      allow create: if
        request.resource.data.keys().hasAll([
          'name',
          'jobTitle',
          'organisation',
          'sector',
          'email',
          'phone',
          'country',
          'callbackTime',
          'message',
          'consent',
          'submittedAt',
          'source'
        ])
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 2
        && request.resource.data.name.size() <= 150
        && request.resource.data.jobTitle is string
        && request.resource.data.jobTitle.size() >= 2
        && request.resource.data.jobTitle.size() <= 150
        && request.resource.data.organisation is string
        && request.resource.data.organisation.size() >= 2
        && request.resource.data.organisation.size() <= 200
        && request.resource.data.sector is string
        && request.resource.data.sector.size() >= 2
        && request.resource.data.sector.size() <= 150
        && request.resource.data.email is string
        && request.resource.data.email.size() >= 5
        && request.resource.data.email.size() <= 254
        && request.resource.data.phone is string
        && request.resource.data.phone.size() >= 5
        && request.resource.data.phone.size() <= 50
        && request.resource.data.country is string
        && request.resource.data.country.size() >= 2
        && request.resource.data.country.size() <= 100
        && request.resource.data.callbackTime is string
        && request.resource.data.callbackTime.size() <= 100
        && request.resource.data.message is string
        && request.resource.data.message.size() <= 5000
        && request.resource.data.consent == true
        && request.resource.data.source == 'callback.html'
        && request.resource.data.submittedAt == request.time;

      allow read, update, delete: if false;
    }

    // Broker social posts are readable to authenticated members. A post can only
    // be created or deleted by the UID recorded as its owner; posts are immutable.
    match /brokerPosts/{postId} {
      allow read: if request.auth != null;

      allow create: if request.auth != null
        && request.resource.data.keys().hasAll(['ownerUid', 'body', 'createdAt'])
        && request.resource.data.keys().hasOnly(['ownerUid', 'body', 'bodyHtml', 'createdAt', 'attachments', 'repostOf'])
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.body is string
        && request.resource.data.body.size() >= 1
        && request.resource.data.body.size() <= 140
        && (!('bodyHtml' in request.resource.data)
          || (request.resource.data.bodyHtml is string
            && request.resource.data.bodyHtml.size() <= 4000))
        && request.resource.data.createdAt == request.time
        && (!('attachments' in request.resource.data)
          || (request.resource.data.attachments is list
            && request.resource.data.attachments.size() <= 5))
        && (!('repostOf' in request.resource.data)
          || (request.resource.data.repostOf is map
            && request.resource.data.repostOf.keys().hasOnly(['postId', 'ownerUid', 'authorName'])
            && request.resource.data.repostOf.postId is string
            && request.resource.data.repostOf.ownerUid is string
            && request.resource.data.repostOf.authorName is string
            && exists(/databases/$(database)/documents/brokerPosts/$(request.resource.data.repostOf.postId))
            && get(/databases/$(database)/documents/brokerPosts/$(request.resource.data.repostOf.postId)).data.ownerUid == request.resource.data.repostOf.ownerUid
            && request.resource.data.repostOf.ownerUid != request.auth.uid));

      allow update: if false;
      allow delete: if request.auth != null
        && resource.data.ownerUid == request.auth.uid;

      match /replies/{replyId} {
        allow read: if request.auth != null;

        allow create: if request.auth != null
          && exists(/databases/$(database)/documents/brokerPosts/$(postId))
          && get(/databases/$(database)/documents/brokerPosts/$(postId)).data.ownerUid != request.auth.uid
          && request.resource.data.keys().hasAll(['ownerUid', 'body', 'createdAt'])
          && request.resource.data.keys().hasOnly(['ownerUid', 'body', 'createdAt'])
          && request.resource.data.ownerUid == request.auth.uid
          && request.resource.data.body is string
          && request.resource.data.body.size() >= 1
          && request.resource.data.body.size() <= 140
          && request.resource.data.createdAt == request.time;

        allow update: if false;
        // A reply author may delete their reply. The parent post's author can
        // also remove replies when deleting that post.
        allow delete: if request.auth != null
          && (
            resource.data.ownerUid == request.auth.uid
            || get(/databases/$(database)/documents/brokerPosts/$(postId)).data.ownerUid == request.auth.uid
          );
      }
    }

    // A member's likes are stored only in that member's private subcollection.
    // No other member (including the author of a liked post) can read them.
    match /userPostLikes/{userId}/likes/{postId} {
      allow read, delete: if request.auth != null
        && request.auth.uid == userId;

      allow create, update: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.keys().hasAll(['postId', 'likedAt'])
        && request.resource.data.keys().hasOnly(['postId', 'likedAt'])
        && request.resource.data.postId == postId
        && request.resource.data.likedAt == request.time
        && exists(/databases/$(database)/documents/brokerPosts/$(postId));
    }


    // Hamlet deal records are private to the signed-in broker who owns them.
    match /hamletDeals/{dealId} {
      allow read: if request.auth != null && resource.data.uid == request.auth.uid;

      allow create: if request.auth != null
        && request.resource.data.keys().hasAll([
          'id','uid','name','property','type','value','stage','owner','client','notes','createdAt','updatedAt'
        ])
        && request.resource.data.keys().hasOnly([
          'id','uid','name','property','propertyResourceId','contactUid','type','value','stage','owner','client','notes','createdAt','updatedAt'
        ])
        && request.resource.data.id == dealId
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 1
        && request.resource.data.name.size() <= 100
        && request.resource.data.property is string
        && request.resource.data.property.size() <= 120
        && (!('propertyResourceId' in request.resource.data)
          || request.resource.data.propertyResourceId == ''
          || (request.resource.data.propertyResourceId is string
            && request.resource.data.propertyResourceId.size() <= 200
            && exists(/databases/$(database)/documents/commercialProperties/$(request.resource.data.propertyResourceId))
            && get(/databases/$(database)/documents/commercialProperties/$(request.resource.data.propertyResourceId)).data.ownerUid == request.auth.uid))
        && (!('contactUid' in request.resource.data)
          || (request.resource.data.contactUid is string
            && request.resource.data.contactUid.size() <= 128
            && exists(/databases/$(database)/documents/publicProfiles/$(request.resource.data.contactUid))))
        && request.resource.data.type in ['Acquisition','Disposal','Leasing','Investment','Development']
        && request.resource.data.value is number
        && request.resource.data.value >= 0
        && request.resource.data.stage in [
          'Initial Inspection','LOI Issued','Due Diligence','Under Contract',
          'Lease Execution','Closing','Commission Payout','Closed'
        ]
        && request.resource.data.owner is string
        && request.resource.data.owner.size() <= 80
        && request.resource.data.client is string
        && request.resource.data.client.size() <= 100
        && request.resource.data.notes is string
        && request.resource.data.notes.size() <= 1000
        && request.resource.data.createdAt is string
        && request.resource.data.createdAt.size() <= 50
        && request.resource.data.updatedAt == request.time;

      allow update: if request.auth != null
        && resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasAll([
          'id','uid','name','property','type','value','stage','owner','client','notes','createdAt','updatedAt'
        ])
        && request.resource.data.keys().hasOnly([
          'id','uid','name','property','propertyResourceId','contactUid','type','value','stage','owner','client','notes','createdAt','updatedAt'
        ])
        && request.resource.data.id == dealId
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 1
        && request.resource.data.name.size() <= 100
        && request.resource.data.property is string
        && request.resource.data.property.size() <= 120
        && (!('propertyResourceId' in request.resource.data)
          || request.resource.data.propertyResourceId == ''
          || (request.resource.data.propertyResourceId is string
            && request.resource.data.propertyResourceId.size() <= 200
            && exists(/databases/$(database)/documents/commercialProperties/$(request.resource.data.propertyResourceId))
            && get(/databases/$(database)/documents/commercialProperties/$(request.resource.data.propertyResourceId)).data.ownerUid == request.auth.uid))
        && (!('contactUid' in request.resource.data)
          || (request.resource.data.contactUid is string
            && request.resource.data.contactUid.size() <= 128
            && exists(/databases/$(database)/documents/publicProfiles/$(request.resource.data.contactUid))))
        && request.resource.data.type in ['Acquisition','Disposal','Leasing','Investment','Development']
        && request.resource.data.value is number
        && request.resource.data.value >= 0
        && request.resource.data.stage in [
          'Initial Inspection','LOI Issued','Due Diligence','Under Contract',
          'Lease Execution','Closing','Commission Payout','Closed'
        ]
        && request.resource.data.owner is string
        && request.resource.data.owner.size() <= 80
        && request.resource.data.client is string
        && request.resource.data.client.size() <= 100
        && request.resource.data.notes is string
        && request.resource.data.notes.size() <= 1000
        && request.resource.data.updatedAt == request.time;

      allow delete: if request.auth != null && resource.data.uid == request.auth.uid;
    }

    // Critical-path milestones are private, owner-managed records. A separate
    // server-only delivery log prevents ordinary clients from spoofing sent reminders.
    match /hamletReminders/{reminderId} {
      allow read: if request.auth != null && resource.data.uid == request.auth.uid;

      allow create: if request.auth != null
        && request.resource.data.keys().hasAll([
          'id','uid','title','dealId','dueDate','owner','email','leadDays','notes','done','createdAt','updatedAt'
        ])
        && request.resource.data.keys().hasOnly([
          'id','uid','title','dealId','dueDate','owner','email','leadDays','notes','done','createdAt','updatedAt'
        ])
        && request.resource.data.id == reminderId
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.title is string
        && request.resource.data.title.size() >= 1
        && request.resource.data.title.size() <= 120
        && request.resource.data.dealId is string
        && request.resource.data.dealId.size() <= 200
        && request.resource.data.dueDate is string
        && request.resource.data.dueDate.size() == 10
        && request.resource.data.owner is string
        && request.resource.data.owner.size() <= 100
        && request.resource.data.email is string
        && request.resource.data.email.size() <= 1000
        && request.resource.data.leadDays is int
        && request.resource.data.leadDays >= 0
        && request.resource.data.leadDays <= 30
        && request.resource.data.notes is string
        && request.resource.data.notes.size() <= 800
        && request.resource.data.done is bool
        && request.resource.data.createdAt is string
        && request.resource.data.createdAt.size() <= 50
        && request.resource.data.updatedAt == request.time;

      allow update: if request.auth != null
        && resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasAll([
          'id','uid','title','dealId','dueDate','owner','email','leadDays','notes','done','createdAt','updatedAt'
        ])
        && request.resource.data.keys().hasOnly([
          'id','uid','title','dealId','dueDate','owner','email','leadDays','notes','done','createdAt','updatedAt'
        ])
        && request.resource.data.id == reminderId
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.title is string
        && request.resource.data.title.size() >= 1
        && request.resource.data.title.size() <= 120
        && request.resource.data.dealId is string
        && request.resource.data.dealId.size() <= 200
        && request.resource.data.dueDate is string
        && request.resource.data.dueDate.size() == 10
        && request.resource.data.owner is string
        && request.resource.data.owner.size() <= 100
        && request.resource.data.email is string
        && request.resource.data.email.size() <= 1000
        && request.resource.data.leadDays is int
        && request.resource.data.leadDays >= 0
        && request.resource.data.leadDays <= 30
        && request.resource.data.notes is string
        && request.resource.data.notes.size() <= 800
        && request.resource.data.done is bool
        && request.resource.data.updatedAt == request.time;

      allow delete: if request.auth != null && resource.data.uid == request.auth.uid;
    }

    match /hamletReminderDeliveries/{deliveryId} {
      allow read, write: if false;
    }

  }
}