  <script>
	(function () {
	  var cookieName = 'ibr_cookie_consent_v1';
	  function setCookie(name, value, days) {
		var d = new Date();
		d.setTime(d.getTime() + (days * 24 * 60 * 60 * 1000));
		document.cookie = name + '=' + encodeURIComponent(value) + ';expires=' + d.toUTCString() + ';path=/;SameSite=Lax';
	  }
	  function getCookie(name) {
		var v = document.cookie.match('(^|;)\\s*' + name + '\\s*=\\s*([^;]+)');
		return v ? decodeURIComponent(v.pop()) : null;
	  }
	  var bar = document.getElementById('cookieConsentBar');
	  if (!bar) return;
	  if (getCookie(cookieName)) {
		bar.style.display = 'none';
		return;
	  }
	  var accept = document.getElementById('cookieAcceptBtn');
	  var decline = document.getElementById('cookieDeclineBtn');
	  if (accept) accept.addEventListener('click', function () { setCookie(cookieName, 'accepted', 365); bar.style.display = 'none'; });
	  if (decline) decline.addEventListener('click', function () { setCookie(cookieName, 'declined', 365); bar.style.display = 'none'; });
	})();
  </script>

  <script>
	window.addEventListener('DOMContentLoaded', function () {
	  if (!window.firebase || !window.firebaseConfig) return;
	  try { firebase.initializeApp(window.firebaseConfig); } catch (e) {}

	  var auth = firebase.auth();
	  var db = firebase.firestore();
	  var liveShell = document.getElementById('liveShell');
	  var loginSection = document.getElementById('loginSection');
	  var signOutBtn = document.getElementById('signOutBtn');
	  var signInLink = document.getElementById('signInLink');
	  var jobsGrid = document.getElementById('jobsGrid');
	  var jobsEmptyState = document.getElementById('jobsEmptyState');
	  var formStatus = document.getElementById('formStatus');
	  var searchInput = document.getElementById('searchInput');
	  var statusFilter = document.getElementById('statusFilter');
	  var saveDraftBtn = document.getElementById('saveDraftBtn');
	  var jobForm = document.getElementById('jobForm');
	  var unsubscribeJobs = null;
	  var currentUser = null;
	  var allJobs = [];

	  var metricTotal = document.getElementById('metricTotal');
	  var metricReady = document.getElementById('metricReady');
	  var metricDrafts = document.getElementById('metricDrafts');

	  function escapeHtml(value) {
		return String(value || '').replace(/[&<>"]/g, function (ch) {
		  return ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[ch];
		});
	  }

	  function normalizeText(value) {
		return String(value || '').toLowerCase().trim();
	  }

	  function setStatus(message, kind) {
		if (!formStatus) return;
		formStatus.textContent = message || '';
		formStatus.style.color = kind === 'error' ? '#b91c1c' : kind === 'success' ? '#166534' : '#5b687a';
	  }

	  function getFormData() {
		return {
		  jobTitle: document.getElementById('jobTitle').value.trim(),
		  companyName: document.getElementById('companyName').value.trim(),
		  location: document.getElementById('location').value.trim(),
		  employmentType: document.getElementById('employmentType').value,
		  workplaceType: document.getElementById('workplaceType').value,
		  applyUrl: document.getElementById('applyUrl').value.trim(),
		  salaryRange: document.getElementById('salaryRange').value.trim(),
		  jobDescription: document.getElementById('jobDescription').value.trim(),
		  postingNotes: document.getElementById('postingNotes').value.trim()
		};
	  }

	  function fillForm(job) {
		document.getElementById('jobTitle').value = job.jobTitle || '';
		document.getElementById('companyName').value = job.companyName || '';
		document.getElementById('location').value = job.location || '';
		document.getElementById('employmentType').value = job.employmentType || '';
		document.getElementById('workplaceType').value = job.workplaceType || '';
		document.getElementById('applyUrl').value = job.applyUrl || '';
		document.getElementById('salaryRange').value = job.salaryRange || '';
		document.getElementById('jobDescription').value = job.jobDescription || '';
		document.getElementById('postingNotes').value = job.postingNotes || '';
	  }

	  function renderJobs() {
		if (!jobsGrid) return;
		var search = normalizeText(searchInput ? searchInput.value : '');
		var status = statusFilter ? statusFilter.value : 'all';
		var filtered = allJobs.filter(function (job) {
		  var jobStatus = job.postingState === 'queued' ? 'ready' : job.postingState;
		  var matchesStatus = status === 'all' || jobStatus === status;
		  var haystack = [job.jobTitle, job.companyName, job.location, job.employmentType, job.workplaceType, job.salaryRange, job.postingState].join(' ').toLowerCase();
		  var matchesSearch = !search || haystack.indexOf(search) !== -1;
		  return matchesStatus && matchesSearch;
		});

		if (metricTotal) metricTotal.textContent = String(allJobs.length);
		if (metricReady) metricReady.textContent = String(allJobs.filter(function (job) { return job.postingState === 'ready' || job.postingState === 'queued'; }).length);
		if (metricDrafts) metricDrafts.textContent = String(allJobs.filter(function (job) { return job.postingState === 'draft'; }).length);

		if (!filtered.length) {
		  jobsGrid.innerHTML = '';
		  if (jobsEmptyState) jobsEmptyState.style.display = 'block';
		  return;
		}

		if (jobsEmptyState) jobsEmptyState.style.display = 'none';
		jobsGrid.innerHTML = filtered.map(function (job) {
		  var displayStatus = job.postingState === 'queued' ? 'ready' : (job.postingState || 'draft');
		  var statusLabel = displayStatus === 'ready' ? 'Ready to post' : displayStatus === 'published' ? 'Posted' : displayStatus;
		  var statusClass = 'status-' + displayStatus;
		  var publishedAt = job.publishedAt && job.publishedAt.toDate ? job.publishedAt.toDate() : (job.publishedAt ? new Date(job.publishedAt) : null);
		  var createdAt = job.createdAt && job.createdAt.toDate ? job.createdAt.toDate() : (job.createdAt ? new Date(job.createdAt) : null);
		  var postedDate = publishedAt || createdAt;
		  var postedLabel = postedDate ? postedDate.toLocaleString() : 'Just now';
		  var applyButton = job.applyUrl ? '<a class="btn btn-ghost" href="' + escapeHtml(job.applyUrl) + '" target="_blank" rel="noopener noreferrer">Open application</a>' : '';
		  var editButton = job.uid === (currentUser && currentUser.uid) ? '<button class="btn btn-small" type="button" data-edit-job="' + escapeHtml(job.id) + '">Edit</button>' : '';
		  var markPostedButton = job.uid === (currentUser && currentUser.uid) && displayStatus !== 'published' ? '<button class="btn btn-small" type="button" data-mark-posted="' + escapeHtml(job.id) + '">Mark as Posted</button>' : '';
		  return '' +
			'<article class="job-card">' +
			  '<div style="display:flex;justify-content:space-between;gap:10px;align-items:start;flex-wrap:wrap;">' +
				'<div>' +
				  '<h3>' + escapeHtml(job.jobTitle) + '</h3>' +
				  '<div class="job-meta"><span>' + escapeHtml(job.companyName) + '</span><span>•</span><span>' + escapeHtml(job.location) + '</span></div>' +
				'</div>' +
				'<span class="status-pill ' + statusClass + '">' + escapeHtml(statusLabel) + '</span>' +
			  '</div>' +
			  '<div class="job-meta"><span>' + escapeHtml(job.employmentType || 'Employment type not set') + '</span><span>•</span><span>' + escapeHtml(job.workplaceType || 'Workplace type not set') + '</span><span>•</span><span>' + escapeHtml(postedLabel) + '</span></div>' +
			  (job.salaryRange ? '<div class="job-meta"><span>Salary: ' + escapeHtml(job.salaryRange) + '</span></div>' : '') +
			  '<p class="job-description">' + escapeHtml(job.jobDescription) + '</p>' +
			  '<div class="job-actions">' +
				applyButton +
				editButton +
				markPostedButton +
				'<button class="btn btn-ghost" type="button" data-reuse-job="' + escapeHtml(job.id) + '">Reuse</button>' +
			  '</div>' +
			'</article>';
		}).join('');
	  }

	  function attachCardActions() {
		jobsGrid.querySelectorAll('[data-edit-job]').forEach(function (button) {
		  button.addEventListener('click', function () {
			var job = allJobs.find(function (entry) { return entry.id === button.getAttribute('data-edit-job'); });
			if (!job) return;
			fillForm(job);
			setStatus('Loaded the selected advert back into the form for editing.', 'success');
		  });
		jobsGrid.querySelectorAll('[data-mark-posted]').forEach(function (button) {
		  button.addEventListener('click', async function () {
			var job = allJobs.find(function (entry) { return entry.id === button.getAttribute('data-mark-posted'); });
			if (!job || job.uid !== (currentUser && currentUser.uid)) return;
			try {
			  await db.collection('jobAdverts').doc(job.id).update({
				postingState: 'published',
				publishedAt: firebase.firestore.FieldValue.serverTimestamp(),
				updatedAt: firebase.firestore.FieldValue.serverTimestamp()
			  });
			  setStatus('Marked as posted on LinkedIn.', 'success');
			} catch (error) {
			  setStatus('Unable to update the advert: ' + (error.message || 'unknown error'), 'error');
			}
		  });
		});
		});
		jobsGrid.querySelectorAll('[data-reuse-job]').forEach(function (button) {
		  button.addEventListener('click', function () {
			var job = allJobs.find(function (entry) { return entry.id === button.getAttribute('data-reuse-job'); });
			if (!job) return;
			fillForm(job);
			setStatus('Copied the selected advert into the composer.', 'success');
		  });
		});
	  }

	  function bindRealtimeFeed() {
		if (unsubscribeJobs) unsubscribeJobs();
		unsubscribeJobs = db.collection('jobAdverts').orderBy('createdAt', 'desc').limit(100).onSnapshot(function (snapshot) {
		  allJobs = snapshot.docs.map(function (doc) {
			var data = doc.data() || {};
			data.id = doc.id;
			return data;
		  });
		  renderJobs();
		  attachCardActions();
		}, function (error) {
		  console.error(error);
		  setStatus('Unable to load the job feed: ' + (error.message || 'unknown error'), 'error');
		});
	  }

	  async function saveJobAdvert(postingState) {
		if (!currentUser) {
		  setStatus('Please sign in before creating job adverts.', 'error');
		  return null;
		}

		var payload = getFormData();
		if (!payload.jobTitle || !payload.companyName || !payload.location || !payload.employmentType || !payload.workplaceType || !payload.jobDescription) {
		  setStatus('Please complete all required fields before saving or adding the advert to the feed.', 'error');
		  return null;
		}

		var now = firebase.firestore.FieldValue.serverTimestamp();
		var docData = {
		  uid: currentUser.uid,
		  authorName: currentUser.displayName || '',
		  authorEmail: currentUser.email || '',
		  jobTitle: payload.jobTitle,
		  companyName: payload.companyName,
		  location: payload.location,
		  employmentType: payload.employmentType,
		  workplaceType: payload.workplaceType,
		  applyUrl: payload.applyUrl,
		  salaryRange: payload.salaryRange,
		  jobDescription: payload.jobDescription,
		  postingNotes: payload.postingNotes,
		  postingState: postingState,
		  createdAt: now,
		  updatedAt: now
		};

		var docRef = await db.collection('jobAdverts').add(docData);
		return { id: docRef.id, data: docData };
	  }

	  async function handleSaveDraft() {
		try {
		  setStatus('Saving draft...', '');
		  await saveJobAdvert('draft');
		  setStatus('Draft saved to the live feed.', 'success');
		  jobForm.reset();
		} catch (error) {
		  console.error(error);
		  setStatus('Unable to save draft: ' + (error.message || 'unknown error'), 'error');
		}
	  }

	  async function handleAddToFeed(event) {
		event.preventDefault();
		try {
		  setStatus('Adding advert to the live feed...', '');
		  var saved = await saveJobAdvert('ready');
		  if (!saved) return;
		  setStatus('Advert is ready. Post it manually to LinkedIn when approved.', 'success');
		  jobForm.reset();
		} catch (error) {
		  console.error(error);
		  setStatus('Unable to add advert to the feed: ' + (error.message || 'unknown error'), 'error');
		}
	  }

	  auth.onAuthStateChanged(function (user) {
		currentUser = user || null;
		if (user) {
		  document.body.classList.add('has-sidebar');
		  loginSection.style.display = 'none';
		  liveShell.style.display = 'block';
		  signOutBtn.style.display = 'inline-flex';
		  signInLink.style.display = 'none';
		  bindRealtimeFeed();
		} else {
		  document.body.classList.remove('has-sidebar');
		  loginSection.style.display = 'block';
		  liveShell.style.display = 'none';
		  signOutBtn.style.display = 'none';
		  signInLink.style.display = 'inline-flex';
		  if (unsubscribeJobs) {
			unsubscribeJobs();
			unsubscribeJobs = null;
		  }
		  allJobs = [];
		}
	  });

	  if (signOutBtn) {
		signOutBtn.addEventListener('click', function () {
		  auth.signOut();
		});
	  }

	  if (saveDraftBtn) {
		saveDraftBtn.addEventListener('click', handleSaveDraft);
	  }
	  if (jobForm) {
		jobForm.addEventListener('submit', handleAddToFeed);
		jobForm.addEventListener('reset', function () {
		  setStatus('Form cleared.', '');
		});
	  }
	  if (searchInput) {
		searchInput.addEventListener('input', renderJobs);
	  }
	  if (statusFilter) {
		statusFilter.addEventListener('change', renderJobs);
	  }
	});
  </script>
